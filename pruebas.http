@host = http://localhost:5117

# Sustituye el valor por la contraseña local configurada en SeedAdmin:Password.
@adminPassword = cambia-esta-contrasena

# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "nombreUsuario": "admin", "password": "{{adminPassword}}" }

@token = {{login.response.body.$.token}}

### Crear cuenta 1
POST {{host}}/api/cuentas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "numeroCuenta": "001-0001", "titular": "Juan Pérez", "tipo": "CajaAhorro", "moneda": "BOB", "saldoInicial": 1000 }

### Crear cuenta 2
POST {{host}}/api/cuentas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "numeroCuenta": "001-0002", "titular": "María Gómez", "tipo": "CajaAhorro", "moneda": "BOB", "saldoInicial": 1000 }

### Depósito de 500 en la cuenta 1
POST {{host}}/api/transacciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cuentaId": 1, "tipo": "Deposito", "monto": 500, "descripcion": "Depósito en ventanilla" }

### Retiro de 200 de la cuenta 1
POST {{host}}/api/transacciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cuentaId": 1, "tipo": "Retiro", "monto": 200 }

### Transferencia de 300 de la cuenta 1 a la 2
POST {{host}}/api/transacciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cuentaId": 1, "cuentaDestinoId": 2, "tipo": "Transferencia", "monto": 300 }

### Retiro imposible (debe dar 400: saldo insuficiente)
POST {{host}}/api/transacciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cuentaId": 1, "tipo": "Retiro", "monto": 999999 }

### Listar cuentas
GET {{host}}/api/cuentas
Authorization: Bearer {{token}}

### Listar transacciones con filtros
GET {{host}}/api/transacciones?cuentaId=1&tipo=Retiro&pagina=1&tamanoPagina=10
Authorization: Bearer {{token}}

### Transacciones en Excel
GET {{host}}/api/reportes/transacciones?formato=Excel
Authorization: Bearer {{token}}

### Transacciones en PDF, solo retiros
GET {{host}}/api/reportes/transacciones?formato=Pdf&tipo=Retiro
Authorization: Bearer {{token}}

### Alertas altas en Excel
GET {{host}}/api/reportes/alertas?formato=Excel&severidad=Alta
Authorization: Bearer {{token}}

### Bitácora en PDF
GET {{host}}/api/reportes/auditoria?formato=Pdf
Authorization: Bearer {{token}}

### La exportación quedó registrada
GET {{host}}/api/auditoria?accion=Exportar
Authorization: Bearer {{token}}
